# ─────────────────────────────────────────────────────────────
# Agent X — environment config (copy to .env, fill in values)
# ─────────────────────────────────────────────────────────────
# Minimum to boot: DATABASE_URL. Then run `python scripts/init_db.py`, which
# generates AGENT_X_ROOT_KEY in place and applies the schema.

# ── CockroachDB Basic (free) — REQUIRED ──
# Cockroach Cloud → cluster → Connect → General connection string.
# sslmode=verify-full also needs the CA cert at ~/.postgresql/root.crt
# (the same Connect dialog gives you the download command).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# ── CockroachDB Managed MCP Server ──
# Reference only: no application code reads these. The managed endpoint and cluster
# id are configured in .mcp.json, which is the source of truth. Kept here so the
# cluster id is discoverable alongside the rest of the config. See docs/MCP.md.
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_API_KEY=

# ── LLM (Ollama local for dev, hosted for deploy) ──
# Ollama needs no key — just `ollama pull <model>` and leave these as-is.
# For deploy, swap to a hosted provider: groq / cerebras / openrouter / gemini.
#   groq       → console.groq.com/keys
#   cerebras   → cloud.cerebras.ai
#   openrouter → openrouter.ai/keys
#   gemini     → aistudio.google.com/apikey
LLM_PROVIDER=ollama
LLM_MODEL=gpt-oss-120b
LLM_API_KEY=
LLM_ENDPOINT=https://api.cerebras.ai/v1

# Optional per-task routing: point ONE task at a different LiteLLM model string
# ("groq/llama-3.1-8b-instant", "openai/gpt-4o", "gemini/gemini-1.5-flash") without
# touching LLM_MODEL above. Uses LLM_API_KEY. Leave blank and that task falls back to
# LLM_PROVIDER/LLM_MODEL — a single-model deployment needs none of this.
AGENT_X_MODEL_CLASSIFY=
AGENT_X_MODEL_PLAN=
AGENT_X_MODEL_EXTRACT=

# ── Embeddings (fastembed, local, 384-d) ──
# Not an API key — the model downloads automatically on first run, free and offline.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# ── Access control ──
# If set, every MUTATING route (ingest, upload, forget, demote, restore, curation
# cycle, workspace create/delete, model switch) requires:
#     Authorization: Bearer <token>
# Reads (/api/ask, /api/verify, browsing) stay public. LEAVE THIS UNSET AND ALL
# WRITES ARE OPEN TO ANYONE — set it before any public deploy. Value is yours to
# invent; the README hands judges this one.
AGENT_X_AUTH_TOKEN=agent-x-judge-75a0f127

# Set to 1 to pin the model on this deployment (blocks the in-app model picker).
AGENT_X_LOCK_MODEL=

# Set to 0 to disable simulated mock data and use real-time live capability providers
AGENT_X_SANDBOX=0

# ── Consumer resolution engine (optional) ──
# All blank by default. Point it at CockroachDB for AS OF SYSTEM TIME proofs and
# vector recall, or leave DATABASE_URL unset and it runs on a local SQLite file
# with the same signed receipts and crypto-shred.
#   AGENT_X_ENGINE=cockroachdb|sqlite   force the engine; default auto-detects
#   AGENT_X_DB_PATH                     local SQLite file path; default data/agentx.db
#   AGENT_X_SANDBOX=0                   disable the 5 sandbox demo companies
#
# Live SMTP email (optional). Set all five and Agent X sends real email through
# `live:smtp` instead of the sandbox mailbox for any counterparty the sandbox
# doesn't know. Leave any one unset and no live send is ever attempted — see
# agentx/execution/providers/live_providers.py.
AGENT_X_SMTP_HOST=
AGENT_X_SMTP_PORT=587
AGENT_X_SMTP_USER=
AGENT_X_SMTP_PASSWORD=
AGENT_X_SMTP_FROM=
# Set to 0 to use implicit TLS (port 465) instead of STARTTLS (port 587, default).
AGENT_X_SMTP_TLS=1

# ── Voice intake (optional — and most deployments should leave it blank) ──
# Speaking a complaint instead of typing it works out of the box: the browser's
# own speech recognition transcribes locally, so the audio never leaves the
# visitor's device and this server never receives it. That is the private path
# and it is the default.
#
# Set this ONLY to support browsers with no built-in recogniser. It sends the
# audio clip to a hosted Whisper API for transcription. The clip is never stored
# — not on disk, not in the database, not in a log — but it does leave the
# device, which is a materially different privacy posture, and every transcript
# says which path produced it.
#
# Absent (the normal case): POST /api/agentx/voice/transcribe answers 501 and the
# UI tells the visitor to type. Never a silent fallback.
AGENT_X_GROQ_API_KEY=
# Override the speech model if you need to (default: whisper-large-v3-turbo).
AGENT_X_SPEECH_MODEL=

# ── AWS (optional — S3 object-locked WORM erasure certificates) ──
# Leave blank and certificates are still built and ECDSA-signed locally; only the
# S3 copy is skipped. S3 activates when AWS_ACCESS_KEY_ID *and* S3_CERT_BUCKET are set.
# Credentials: IAM console → Users → Security credentials → Create access key,
# with the policy in infra/iam-policy.json attached.
#
# NOTE: Object Lock must be enabled AT BUCKET CREATION — it cannot be added later.
# This name must match the bucket you actually created AND the ARNs in
# infra/iam-policy.json, or uploads fail with AccessDenied (swallowed into the
# certificate's `store_error` field, so it fails quietly).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_CERT_BUCKET=agent-x-erasure-certs

# WORM retention for certificate objects.
#   S3_LOCK_MODE: COMPLIANCE (nobody can delete before expiry, including you)
#                 | GOVERNANCE (privileged override allowed)
#   S3_LOCK_DAYS: retention window; default 1 — long enough to demo, short enough to clean up
S3_LOCK_MODE=COMPLIANCE
S3_LOCK_DAYS=1

# ── App secrets (generated locally; never commit real values) ──
# AGENT_X_ROOT_KEY is filled in by scripts/init_db.py on first run. Do NOT rotate it:
# it wraps every per-subject data key, so losing it makes all stored content
# permanently undecryptable.
# AES-256 root key for per-subject envelope encryption
AGENT_X_ROOT_KEY=

# ECDSA (P-256) key that signs erasure certificates. Unset ⇒ certificates are issued
# UNSIGNED and /verify reports signature_valid: null. Not auto-generated — mint one:
#   python -c "from aws import certificate; print(certificate.generate_signing_key())"
AGENT_X_SIGNING_KEY=

# Reserved. scripts/init_db.py generates this, but no code reads it yet — it exists
# for future session/cookie signing. Harmless to leave blank.
# session / auth secret
APP_SECRET=


# ════════════════════════════════════════════════════════════════════════════
# CAPABILITY TRACKS
#
# Agent X's capability tracks (see agentx/tracks.py). Each track is reported at
# GET /api/agentx/tracks as `live`, `service` or `unavailable`, resolved at call
# time — a track whose key is blank is reported as not wired rather than being
# hidden or, worse, claimed to work.
#
# EVERYTHING BELOW IS OPTIONAL. Agent X's shipped tracks — consumer resolution,
# documents, research, erasure, voice, recovery, audit — need none of it and
# work with every line here left blank.
#
# The variable NAMES are the ones the underlying implementations already read.
# They are deliberately NOT renamed to an AGENT_X_ prefix: renaming them would
# mean editing vendored code, and the point of that code is that it works.
# ════════════════════════════════════════════════════════════════════════════

# ── Shared model access ─────────────────────────────────────────────────────
# Used by several tracks that call a hosted model. Agent X's own engine does not
# need this; its classifier, policy analysis and planner all run with no model.
OPENAI_API_KEY=
OPENAI_MODEL=

# ── Contract Intelligence ───────────────────────────────────────────────────
# Turns a contract into an interactive artefact rather than a wall of text.
# Runs as its own web service; AGENT_X_CONTRACT_URL is how Agent X reaches it.
AGENT_X_CONTRACT_URL=
TAMBO_API_KEY=
NEXT_PUBLIC_TAMBO_API_KEY=
NEXT_PUBLIC_TAMBO_URL=

# ── Action Workflows ────────────────────────────────────────────────────────
# Describe a multi-step job; watch the workflow execute step by step.
AGENT_X_WORKFLOW_URL=

# ── Safe Operations ─────────────────────────────────────────────────────────
# Detect an operational problem, prepare the fix, hold it for approval.
AGENT_X_OPS_URL=
GEMINI_API_KEY=
# where an approval request is announced
DISCORD_WEBHOOK_URL=

# ── Infrastructure Intelligence ─────────────────────────────────────────────
# Inspect how an application is deployed; propose cost/reliability changes.
AGENT_X_INFRA_URL=
# pipeline orchestrator, if you run one
KESTRA_API_URL=
KESTRA_TENANT=
# local model host; blank falls back to heuristics
OLLAMA_URL=http://localhost:11434
# 1 to prefer a local model over the heuristic path
USE_OLLAMA=1
# 1 to use a fine-tuned local model instead
USE_OUMI=

# ── Model Studio ────────────────────────────────────────────────────────────
# Prepare a dataset, train a small model, evaluate it honestly.
# Training is GPU-bound. Left blank, the track reports itself as not wired
# rather than pretending to train.
AGENT_X_STUDIO_URL=

# ── Learning Memory ─────────────────────────────────────────────────────────
# Remember what someone has learned, find the gaps, suggest what is next.
# CLASSROOM_MODE=demo runs with no credentials at all.
AGENT_X_LEARNING_URL=
# demo (default) | cloud
CLASSROOM_MODE=cloud
COGNEE_CLOUD_URL=
COGNEE_CLOUD_API_KEY=

# ── Emergency Response ──────────────────────────────────────────────────────
# Triage an emergency report, locate it, and route it to responders.
# Dispatch is a consequential action: it is approval-gated by the governor
# regardless of which of these are set.
AGENT_X_EMERGENCY_URL=
# plan/execution engine
PORTIA_API_KEY=
# geocoding + model access
GOOGLE_API_KEY=
# responder notification channel
SLACK_BOT_TOKEN=
# corroborating search
TAVILY_API_KEY=
# public incident signal
TWITTER_BEARER_TOKEN=

# ── Field Intelligence ──────────────────────────────────────────────────────
# Crop-stage aware guidance, scheme eligibility, price signals.
AGENT_X_FIELD_URL=

# ── Agent Observability ─────────────────────────────────────────────────────
# What Agent X's own agents did: tools, latency, cost, failures. Admin-facing.
# Blank disables export; nothing is lost, it simply is not shipped anywhere.
AGENT_X_OTEL_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT=
# e.g. otlp — blank disables the exporter
OTEL_TRACES_EXPORTER=

# ── Vendored subsystem dependencies (all optional) ──────────────────────────
# These belong to capability subsystems vendored into agentx/subsystems/. Each
# is read by the vendored code under its original name. Blank means that track
# reports itself unavailable — never that it silently degrades.
#
# Emergency Response additionally needs a planning library that is not installed
# by default (see requirements-capabilities.txt).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Vulnerability Remediation ───────────────────────────────────────────────
# Find a vulnerable dependency, decide whether it is reachable, prepare the fix.
#
# Every agent in this fleet reasons over the network — there is no offline tier,
# so without GEMINI_API_KEY (set in the section above) the track reports itself
# unavailable rather than degrading. `git` must also be on PATH, since hunting
# and patching clone real repositories.
#
# GITHUB_TOKEN is what separates "can analyse a local checkout" from "can push a
# branch and open a pull request". Without it the track still triages; it just
# says plainly that it cannot open a PR. Any outward action is gated by the
# governor first regardless.
GITHUB_TOKEN=
# Overrides the default Gemini model. Must be 3.5 or newer.
GEMINI_MODEL=
# The repository scanned in a demo run.
DEMO_REPO_URL=
# Evidence store and job queue. Both default to "local" (on-disk under
# data/sentinel_x/); the cloud backends need GCP_PROJECT_ID or AWS credentials.
SENTINEL_STORE_BACKEND=
SENTINEL_QUEUE_BACKEND=
GCP_PROJECT_ID=
